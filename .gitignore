# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local dev scratch/debug scripts (archived, not part of the app)
/_archive/

# Generated performance artifacts (keep the .md summaries, not the raw output)
/docs/performance/bundle-before/
/docs/performance/*.log

# Claude session artifacts
/.claude/

# env
.env.local

# Capacitor generated native projects — regenerated by `npx cap add <platform>`
# in the mobile build (CI or local). Keep only capacitor.config.json + www +
# package.json as the source of truth; never commit the scaffold.
/mobile/android/
/mobile/ios/

# Android signing — NEVER commit the keystore or its passwords.
/mobile/*.keystore
/mobile/*.jks
/mobile/keystore.properties
/mobile/latest.json
backfill-recovery-*.json
backfill-baseline-*.json

# Figma plugin build output
figma-plugin/**/dist/
figma-plugin/*.zip

# Archived code bundles — binary, kept locally for reference only
docs/_archive/*.tgz
/mobile/dist/

# Local investigation scripts — kept on disk, never shipped.
#
# 93 one-off .mjs probes plus the August 2026 codemods live here. They are real
# working history (how a bug was found, what a schema looked like on the day),
# so they are ignored rather than deleted — but they are not the app, they are
# already excluded from eslint and vitest, and committing them would triple the
# tree for no reader.
/scratch/
