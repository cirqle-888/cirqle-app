{
  "name": "cirqle-desktop",
  "version": "0.5.1",
  "private": true,
  "description": "Cirqle + WhatsApp Web, side by side, with one-tap clipboard \u2192 Quick Capture.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "CIRQLE_URL=http://localhost:3000 electron .",
    "pack": "npm run check:ipc && electron-builder --mac --dir",
    "dmg": "npm run check:ipc && electron-builder --mac dmg",
    "check:ipc": "node scripts/check-ipc-channels.js"
  },
  "devDependencies": {
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "puppeteer": "^25.2.1"
  }
}