{
  "appId": "work.cirqle.app",
  "appName": "Cirqle",
  "webDir": "www",
  "server": {
    "url": "https://app.cirqle.work",
    "cleartext": false,
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 4000,
      "launchFadeOutDuration": 200,
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
