{
  "name": "cirqle-designer-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "All-in-one Figma productivity suite: rename, cleaner, accessibility, automator, template validator, component/asset/export managers, analytics and design QA — in one modular plugin.",
  "scripts": {
    "dev": "vite build --watch --config vite.config.ts & vite build --watch --config vite.main.config.ts",
    "build": "npm run build:ui && npm run build:main",
    "build:ui": "vite build --config vite.config.ts",
    "build:main": "vite build --config vite.main.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "jspdf": "^2.5.2"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.100.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.5"
  }
}
